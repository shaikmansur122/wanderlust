<% if (success && success.length) { %>
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <span><%= success %></span>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="alert"
          aria-label="Close">
        </button>
      </div>
    </div>
  </div>
<% } %>
