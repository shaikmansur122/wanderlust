<% layout("/layouts/boilerplate") %>

<!-- 🔍 SEARCH BAR -->
<form class="d-flex justify-content-center my-4" action="/listings" method="GET">
  <input
    type="text"
    name="search"
    value="<%= search %>"
    placeholder="Search by title or location..."
    class="form-control w-50 me-2"
  >
  <button class="btn btn-danger">Search</button>
</form>

<!-- 🌟 MOOD FILTERS -->
<div class="text-center mb-4">
  <a href="/listings?mood=Relax" class="btn btn-outline-primary m-1">😌 Relax</a>
  <a href="/listings?mood=Adventure" class="btn btn-outline-primary m-1">🧗 Adventure</a>
  <a href="/listings?mood=Romantic" class="btn btn-outline-primary m-1">💑 Romantic</a>
  <a href="/listings?mood=Party" class="btn btn-outline-primary m-1">🎉 Party</a>
  <a href="/listings?mood=Nature" class="btn btn-outline-primary m-1">🌿 Nature</a>
  <a href="/listings" class="btn btn-dark m-1">Show All</a>
</div>

<!-- 💰 TAX SWITCH -->
<div class="text-end mb-3">
  <label class="me-2">Show prices with tax</label>
  <input type="checkbox" id="taxSwitch">
</div>

<h3>All Listings</h3>

<div class="row">
  <% if (allListings.length === 0) { %>
    <h5 class="text-center text-muted">No listings found 😕</h5>
  <% } %>

  <% for (let listing of allListings) { %>
    <div class="col-12 col-md-6 col-lg-4 mb-4">
      <a href="/listings/<%= listing._id %>" class="card-link text-decoration-none">
        <div class="card listing-card h-100">
          <img src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1500530855697-b586d89ba3ee' %>" class="listing-img" />

          <div class="card-body">
            <h6><%= listing.title %></h6>
            <p class="badge bg-info text-dark"><%= listing.mood %></p>
            <p class="text-muted"><%= listing.location %></p>
            <p class="price" data-base="<%= listing.price %>">₹<%= listing.price %></p>
          </div>
        </div>
      </a>
    </div>
  <% } %>
</div>

<script>
document.getElementById("taxSwitch").addEventListener("change", function () {
  const prices = document.querySelectorAll(".price");
  prices.forEach(p => {
    let base = parseInt(p.dataset.base);
    p.innerText = "₹" + (this.checked ? Math.round(base * 1.18) : base);
  });
});
</script>
