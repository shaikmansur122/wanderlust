<% layout("layouts/boilerplate") %>

<div class="row">
  <div class="col-8 offset-2">

    <h3>Create a New Listing</h3>

    <form method="POST" action="/listings" novalidate class="needs-validation">

      <div class="mb-3">
        <label class="form-label">Title</label>
        <input
          name="listing[title]"
          placeholder="enter title"
          type="text"
          required
          class="form-control"
        />
        <div class="valid-feedback">it a good title</div>
      </div>

      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea
          name="listing[description]"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">please enter description</div>
      </div>

      <div class="mb-3">
        <label class="form-label">Image Link</label>
        <input
          name="listing[image][url]"
          placeholder="enter image URL"
          type="text"
          class="form-control"
         
        />
        <input
            type="text"
            name="listing[image][filename]"
            placeholder="Image filename"
          />
     
      </div>

      <div class="row">
        <div class="mb-3 col-4">
          <label class="form-label">Price</label>
          <input
            name="listing[price]"
            placeholder="enter price"
            required
            class="form-control"
            
          />
          <div class="invalid-feedback">please enter  valid price</div>
        </div>

        <div class="mb-3 col-8">
          <label class="form-label">Country</label>
          <input
            name="listing[country]"
            placeholder="enter country"
            type="text"
            class="form-control"
            required
          />
          <div class="invalid-feedback">enter a valid county name</div>
        </div>
        
      </div>

      <div class="mb-3">
        <label class="form-label">Location</label>
        <input
          name="listing[location]"
          placeholder="enter location"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">enter a valid location</div>
      </div>

      <button type="submit" class="btn btn-dark add-btn">Add</button>

    </form>

  </div>
</div>

