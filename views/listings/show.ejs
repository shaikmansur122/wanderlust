<% layout("layouts/boilerplate") %>

<div class="row mt-4">
  <div class="col-10 offset-1">

    <h3 class="mb-3">Listing Details</h3>

    <!-- LISTING CARD -->
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="card mb-3 shadow-sm">
          <img src="<%= listing.image?.url || '/images/default.jpg' %>"
               class="card-img-top"
               alt="listing image"
               style="height: 180px; object-fit: cover;" />

          <div class="card-body">
            <h5 class="card-title"><%= listing.title %></h5>
            <p class="text-muted mb-1">
              Hosted by <strong><%= listing.owner.username %></strong>
            </p>
            <p class="card-text"><%= listing.description %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- DETAILS -->
    <ul class="list-group mb-3 w-50 mx-auto">
      <li class="list-group-item">
        &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "Price not available" %>
      </li>
      <li class="list-group-item"><%= listing.location %></li>
      <li class="list-group-item"><%= listing.country %></li>
    </ul>

    <!-- OWNER ACTIONS -->
    <% if (currentUser && listing.owner._id.equals(currentUser._id)) { %>
    <div class="text-center mb-4">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning me-2">Edit</a>
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" style="display:inline;">
        <button class="btn btn-danger">Delete</button>
      </form>
    </div>
    <% } %>

    <!-- 🗺 MAP SECTION -->
    <div id="map" style="height:400px;"></div>

<script>
  const coords = JSON.parse('<%- JSON.stringify(listing.geometry?.coordinates || []) %>');

  if (coords.length === 2) {
    const map = L.map('map').setView([coords[1], coords[0]], 10);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap'
    }).addTo(map);

    L.marker([coords[1], coords[0]])
      .addTo(map)
      .bindPopup("<%= listing.location %>");
  } else {
    document.getElementById("map").innerHTML =
      "<p class='text-center mt-4 text-muted'>Location not available</p>";
  }
</script>

    <!-- ⭐ REVIEW FORM -->
    <% if (currentUser) { %>
    <div class="col-8 offset-2 mb-4">
      <h4>Leave a Review</h4>

      <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>

        <div class="mb-3">
          <label class="form-label">Rating</label>
          <div class="star-rating">
            <% for(let i=5;i>=1;i--){ %>
              <input type="radio" id="star-<%= i %>" name="review[rating]" value="<%= i %>" required />
              <label for="star-<%= i %>"><i class="fa-solid fa-star"></i></label>
            <% } %>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label">Comment</label>
          <textarea name="review[comment]" rows="4" class="form-control" required></textarea>
          <div class="invalid-feedback">Please enter a comment</div>
        </div>

        <button class="btn btn-outline-dark">Submit</button>
      </form>
    </div>
    <% } %>

    <hr />

    <!-- REVIEWS DISPLAY -->
    <h4 class="mt-4 mb-3 text-center">All Reviews</h4>
    <div class="row">

      <% if (listing.reviews.length === 0) { %>
        <p class="text-muted text-center">No reviews yet.</p>
      <% } %>

      <% for (let review of listing.reviews) { %>
        <div class="col-md-6 mb-3">
          <div class="card shadow-sm h-100">
            <div class="card-body">

              <h6 class="card-title mb-1">
                <strong>
                  <% if (currentUser && review.author._id.equals(currentUser._id)) { %>
                    You
                  <% } else { %>
                    <%= review.author.username %>
                  <% } %>
                </strong>
              </h6>

              <div class="review-stars text-warning">
                <% for(let i=1;i<=5;i++){ %>
                  <i class="fa-star <%= i<=review.rating ? 'fa-solid' : 'fa-regular' %>"></i>
                <% } %>
              </div>

              <p class="card-text mt-2"><%= review.comment %></p>

              <% if (currentUser && review.author._id.equals(currentUser._id)) { %>
              <form method="POST"
                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                    class="mt-2">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
              <% } %>

            </div>
          </div>
        </div>
      <% } %>

    </div>
  </div>
</div>
